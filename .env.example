# Required
APP_HOST=0.0.0.0
APP_PORT=8001

# Which game server: "bancho" (bancho.py, the default) or "osu-web" (TomYum + osu-web).
PAYMENTS_BACKEND=bancho

DB_HOST=localhost
DB_PORT=3306
DB_USER=bancho
DB_PASS=changeme
DB_NAME=bancho

# Secret shared between payment-service and bancho.py's /internal/* endpoints.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BANCHO_INTERNAL_TOKEN=change_me_generate_a_secret
BANCHO_INTERNAL_URL=http://localhost:8000

# osu-web only (PAYMENTS_BACKEND=osu-web): where osu-web is reached from here, its
# SHARED_INTEROP_SECRET, and the database holding its accounts (phpbb_users).
OSU_WEB_INTERNAL_URL=
OSU_WEB_INTEROP_SECRET=
OSU_WEB_DB_NAME=osu

DOMAIN=freedomdive.dev
# Where Stripe sends players back after checkout (default https://DOMAIN/support).
SUPPORT_URL=

# TrueMoney
TRUEMONEY_ENABLED=false
TRUEMONEY_PHONE=
DONATION_DAYS_PER_THB=1.8
PROMPTPAY_ENABLED=true
PROMPTPAY_SLIP_MAX_BYTES=5242880

# Discord bot auth (same token as bancho.py)
BOT_API_TOKEN=

# Discord webhooks (optional)
DISCORD_DONATION_WEBHOOK=
DISCORD_AUDIT_LOG_WEBHOOK=

# Stripe (leave empty until ready)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
